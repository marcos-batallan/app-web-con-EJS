<section class="panel-formulario">
    <p class="etiqueta">INGRESO DE NUEVA MASCOTAS</p>
    <h1>
        <%= titulo %>
    </h1>
    <% if (error) { %>
        <p class="error" role="alert">
            <%= error %>
        </p>
        <% } %>
            <form action="/mascotas" method="post" class="formulario">
                <label for="nombre">Nombre</label>
                <input id="nombre" name="nombre" value="<%= valores.nombre ?? '' %>" required>

                <label for="especie">Especie</label>
                <input id="especie" name="especie" value="<%= valores.especie ?? '' %>" required>

                <label for="edad">Edad</label>
                <input type="number" id="edad" name="edad" min="0" value="<%= valores.edad ?? '' %>" required>

                <label for="descripcion">Descripción</label>
                <textarea id="descripcion" name="descripcion" rows="5" required><%= valores.descripcion ?? '' %></textarea>

                <label for="estado">Estado</label>
                <select id="estado" name="estado" required>
                    <option value="">Seleccionar estado</option>
                    <option value="En adopción" <%= valores.estado === "En adopción" ? "selected" : "" %>>En adopción</option>
                    <option value="Reservada" <%= valores.estado === "Reservada" ? "selected" : "" %>>Reservada</option>
                    <option value="Adoptada" <%= valores.estado === "Adoptada" ? "selected" : "" %>>Adoptada</option>
                </select>

                <button type="submit">Guardar mascota nueva</button>
            </form>
</section>