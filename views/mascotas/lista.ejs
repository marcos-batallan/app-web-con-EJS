<header class="cabecera-pagina">
    <div>
        <p class="etiqueta">CATALOGO DE MASCOTAS</p>
        <h1>
            <%= titulo %>
        </h1>
    </div>
    <a class="boton" href="/mascotas/nueva">Agregar mascota</a>
</header>
<% if (mascotas.length===0) { %>
    <p>No hay mascotas disponibles para mostrar.</p>
    <% } else { %>
        <section class="grilla" aria-label="Animales disponibles">
            <% mascotas.forEach((mascota)=> { %>
                <article class="tarjeta">
                    <p class="etiqueta">
                        <%= mascota.especie %>
                    </p>
                    <h2>
                        <%= mascota.nombre %>
                    </h2>
                    <p class="estado"><%= mascota.estado %>
                    </p>
                    <a href="/mascotas/<%= mascota.id %>">Ver detalle</a>
                </article>
            <% }) %>
        </section>
    <% } %>